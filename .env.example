# Copy to backend/.env and adjust. All optional — sensible defaults apply.
GARAK_STUDIO_DEBUG=true
# Override the interpreter/command used to launch garak (e.g. for a venv):
# GARAK_STUDIO_GARAK_COMMAND=python -m garak
# Master key for encrypting stored secrets (recommended in production):
# GARAK_STUDIO_SECRET_KEY=change-me-to-a-long-random-string
# Switch to Postgres:
# GARAK_STUDIO_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/garakstudio
# Ollama daemon URL for local model discovery (Docker: http://host.docker.internal:11434):
# GARAK_STUDIO_OLLAMA_HOST=http://localhost:11434
